            <ActionContent
               title = "Export Build To iCloud"
               scriptText = "set -eo pipefail&#10;BASE_DIR=&quot;/Users/jim/Library/Mobile Documents/com~apple~CloudDocs/bobmacsync&quot;&#10;TIMESTAMP=&quot;$(/bin/date +%Y-%m-%d_%H-%M-%S)&quot;&#10;DEST_DIR=&quot;${BASE_DIR}/${TIMESTAMP}&quot;&#10;SOURCE_APP=&quot;${BUILT_PRODUCTS_DIR}/${FULL_PRODUCT_NAME}&quot;&#10;if [ ! -d &quot;${SOURCE_APP}&quot; ]; then&#10;  echo &quot;warning: Build output not found at ${SOURCE_APP}&quot;&#10;  exit 0&#10;fi&#10;/bin/mkdir -p &quot;${DEST_DIR}&quot;&#10;/usr/bin/ditto &quot;${SOURCE_APP}&quot; &quot;${DEST_DIR}/${FULL_PRODUCT_NAME}&quot;&#10;if [ -n &quot;${DWARF_DSYM_FOLDER_PATH:-}&quot; ] &amp;&amp; [ -n &quot;${DWARF_DSYM_FILE_NAME:-}&quot; ] &amp;&amp; [ -d &quot;${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}&quot; ]; then&#10;  /usr/bin/ditto &quot;${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}&quot; &quot;${DEST_DIR}/${DWARF_DSYM_FILE_NAME}&quot;&#10;fi&#10;echo &quot;Exported build to ${DEST_DIR}/${FULL_PRODUCT_NAME}&quot;"
               shellToInvoke = "/bin/sh">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "712C32AF24BF939100AC75E2"
                     BuildableName = "Reminders MenuBar.app"
                     BlueprintName = "Reminders MenuBar"
                     ReferencedContainer = "container:reminders-menubar.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
